{
  "name": "test-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Каркас тестов для web, mobile web и мобильных приложений iOS/Android",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bddgen": "bddgen",
    "test": "npm run test:web",
    "test:web": "bddgen && playwright test --project=chromium",
    "test:web:headed": "bddgen && playwright test --project=chromium --headed",
    "test:cross": "bddgen && playwright test --project=chromium --project=firefox --project=webkit",
    "test:mobile-web": "bddgen && playwright test --project=mobile-chrome --project=mobile-safari",
    "test:all-ui": "bddgen && playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
    "test:onec": "bddgen && playwright test --project=onec",
    "test:android": "wdio run wdio.android.conf.ts",
    "test:ios": "wdio run wdio.ios.conf.ts",
    "test:unit": "tsx --test src/config/load-env.test.ts src/data/users.test.ts src/integrations/onec/odata.test.ts",
    "check:1c": "tsx scripts/check-onec.ts",
    "report:testmo": "tsx scripts/submit-testmo.ts",
    "report": "playwright show-report",
    "setup:browsers": "playwright install"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "mssql": "^12.7.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@wdio/appium-service": "^10.1.1",
    "@wdio/cli": "^10.1.0",
    "@wdio/cucumber-framework": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/junit-reporter": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/types": "^10.1.0",
    "appium": "^3.9.0",
    "cross-env": "^10.1.0",
    "playwright-bdd": "^9.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
