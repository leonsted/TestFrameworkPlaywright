# Скопируйте этот файл в .env и заполните только то, чем пользуетесь.
# Файл .env не попадает в git.

# Окружение по умолчанию, если не переопределили TEST_ENV: dev | stage | prod
# TEST_ENV=dev

# Учётка сайта на stage/prod (см. users в yaml окружения)
APP_USER=
APP_PASSWORD=

# 1С по HTTP (OData или опубликованная база)
ONEC_USER=
ONEC_PASSWORD=

# 1С через SQL Server, только чтение. Имена таблиц подскажет разработчик 1С.
ONEC_SQL_USER=
ONEC_SQL_PASSWORD=

# Testmo. Токен: Testmo → пользователь → API keys
TESTMO_TOKEN=
# TESTMO_ENABLED=1
